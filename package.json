{
  "name": "praisindo-slides-generator",
  "version": "1.1.0",
  "private": true,
  "description": "Praisindo slide decks, written by Claude in the Praisindo design system and built to PDF and PowerPoint.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node engine/build.mjs",
    "starter": "node engine/build.mjs decks/starter --pptx",
    "examples": "node scripts/build-examples.mjs",
    "typecheck": "tsc --noEmit",
    "wordmark": "node brand/make-wordmark.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "jszip": "3.10.2",
    "pdf-to-img": "7.0.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
