{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": {
      "praisindo-slides": ["./engine/index.ts"]
    }
  },
  "include": ["engine", "brand", "decks", "scripts"],
  "exclude": ["node_modules", "**/output"]
}
